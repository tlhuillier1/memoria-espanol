# Copy to .env.local for `npm run dev` (server-side only, never exposed to the browser).
# Neon connection string — use the "dev" branch locally.
DATABASE_URL=
# The teacher password (any test value locally).
TEACHER_PASSWORD=
# Random string signing the teacher session cookie, e.g. node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=
